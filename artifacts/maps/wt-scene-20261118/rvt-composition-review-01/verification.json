  "finding": {
    "id": "packed_normal_z_is_sign_only",
    "state": "fixed_by_material_native_fix_and_reread",
    "initial_error": "Composite treated sampled normal Z as continuous packed Z. UE compression/copy rounds the packed Z channel before sampling.",
    "source_references": [
      "VirtualTextureMaterial.usf:59-62 pack normalized vector using127/255",
      "VirtualTextureMaterial.usf:147-150 premultiplied outputs",
      "VirtualTextureCompress.usf:344-347 and379 round packedZ",
      "VirtualTextureCommon.ush:969-974 reconstruct sample Z from XY and sign",
      "RuntimeVirtualTextureRender.cpp:647-650 One/InverseSourceAlpha blend",
      "RuntimeVirtualTextureRender.cpp:1192-1197 black RGB and DefaultNormal8Bit auxiliary clears",
      "RHI.cpp:128 defines DefaultNormal8Bit as128/255",
      "MaterialExpressions.cpp:3443 and3710-3717 return native normal unpack without tangent conversion"
    ],
    "fixed_rule": "Remove clear bias and de-premultiply XY; reconstruct magnitude sqrt(saturate(1-dot(XY,XY))) with sampled Z sign."
  },
  "boundaries": {
    "empty_area": "Mask clear128/255 gives coverage0; early return retains base color, world normal, roughness and metallic.",
    "outside_writer_xy_bounds": "inside multiplier forces coverage0 and early base return.",
    "color": "Inputs provide straight linear RGB. UE writer premultiplies exactly once, blend is One/InverseSourceAlpha, sample composition is RVTColor+BaseColor*(1-coverage).",
    "roughness": "DecalRoughness+(BaseRoughness-clear128/255)*(1-coverage) removes auxiliary clear contribution and composites base.",
    "normal_spaces": "Writer transforms tangent NormalOut to world; receiver transforms base tangent normal to world, combines in world and sets tangent_space_normal=False.",
    "ordinary_unbound_scene_decal": "Standard translucent MP outputs remain connected; extra RVT output does not replace them. bind_rvt_world assigns this RVT and NEVER main pass only to the unique world_decal_000 HISM.",
    "codec_limit": "Packed Z is rounded after blending, so its original continuous value is irrecoverable. Near grazing/low coverage even source sign can differ after clear-biased quantization. BC5/BC3 interpolation and GPU pixel rendering are outside this analytic replay."
  },
