@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: Apache-2.0
+// RMSim display-only extension. No public MuJoCo structure layout is changed.
+#ifndef MUJOCO_SRC_RENDER_CLASSIC_RENDER_STATICFLEX_VBO_H_
+#define MUJOCO_SRC_RENDER_CLASSIC_RENDER_STATICFLEX_VBO_H_
+
+#include <mujoco/mjexport.h>
+#include <mujoco/mjmodel.h>
+#include <mujoco/mjrender.h>
+#include <mujoco/mjvisualize.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Explicit opt-in on the thread owning the GL context, before mjr_makeContext.
+// The caller promises the sealed, world-fixed face buffers are immutable for
+// that context's lifetime. Recreate the context if the scene geometry changes.
+// Disable/re-enable may be used to compare the original draw path without
+// changing the model, scene, camera or any shader/material state.
+MJAPI void rmsim_mjr_setStaticFlexCacheEnabled(int enabled);
+MJAPI const char* rmsim_mjr_staticFlexCacheStatus(void);
+
+// Internal context-lifetime hooks and the existing renderer's face-array bind.
+void mjr_rmsimStaticFlexInit(const mjModel* m, const mjrContext* con);
+void mjr_rmsimStaticFlexFree(const mjrContext* con);
+int mjr_rmsimStaticFlexBind(const mjrContext* con, const mjvScene* scn,
+                          const mjvGeom* geom, int faceadr, int facenum);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
