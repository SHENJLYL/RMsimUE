diff --git a/src/engine/engine_staticflex.c b/src/engine/engine_staticflex.c
new file mode 100644
index 0000000..292f3a1
--- /dev/null
+++ b/src/engine/engine_staticflex.c
@@ -0,0 +1,71 @@
+// Copyright 2026 RMsimUE5 contributors
+// Licensed under the Apache License, Version 2.0.
+
+#include "engine/engine_staticflex.h"
+
+#include <stdint.h>
+#include <string.h>
+#include "engine/engine_util_errmem.h"
+
+void mj_staticFlexRebuild(mjModel* m) {
+  mjStaticFlexModelCache* cache = mj_staticFlexModel(m);
+  if (cache->revision == UINT64_MAX) {
+    mjERROR("static flex revision exhausted; create a new model");
+  }
+  ++cache->revision;
+  if (cache->count != m->nflex) {
+    mju_free(cache->world);
+    cache->world = NULL;
+    cache->count = 0;
+    if (m->nflex) {
+      cache->world = (mjtByte*)mju_malloc((size_t)m->nflex);
+      if (!cache->world) {
+        mjERROR("could not allocate static flex eligibility");
+      }
+      cache->count = m->nflex;
+    }
+  }
+  for (int f=0; f < m->nflex; ++f) {
+    int eligible = m->flex_dim[f] == 2 && m->flex_rigid[f] &&
+                   !m->flex_interp[f] && m->flex_nodenum[f] == 0 && !m->flex_passive[f] &&
+                   !m->flex_plasticmode[f] && m->flex_vertnum[f] > 0;
+    for (int i=m->flex_vertadr[f]; eligible &&
+         i < m->flex_vertadr[f] + m->flex_vertnum[f]; ++i) {
+      if (m->flex_vertbodyid[i] != 0) eligible = 0;
+    }
+    cache->world[f] = eligible;
+  }
+}
+
+void mj_staticFlexFree(mjModel* m) {
+  if (m->buffer) mju_free(mj_staticFlexModel(m)->world);
+}
+
+void mj_staticFlexInvalidate(mjData* d) {
+  memset(mj_staticFlexData(d), 0, sizeof(mjStaticFlexDataCache));
+}
+
+int mj_staticFlexWorld(const mjModel* m, int f) {
+  const mjStaticFlexModelCache* cache = mj_staticFlexModel(m);
+  return cache->revision && f >= 0 && f < cache->count && cache->world[f];
+}
+
+int mj_staticFlexCurrent(const mjModel* m, const mjData* d, int needbvh) {
+  const mjStaticFlexDataCache* cache = mj_staticFlexData(d);
+  return cache->valid && cache->owner == m &&
+         cache->revision == mj_staticFlexModel(m)->revision &&
+         (!needbvh || cache->bvh);
+}
+
+void mj_staticFlexCommit(const mjModel* m, mjData* d, int bvh) {
+  mjStaticFlexDataCache* cache = mj_staticFlexData(d);
+  const int retained_bvh = mj_staticFlexCurrent(m, d, 1);
+  cache->owner = m;
+  cache->revision = mj_staticFlexModel(m)->revision;
+  cache->valid = 1;
+  cache->bvh = bvh || retained_bvh;
+}
+
+void mjrmsim_invalidateStaticFlex(mjModel* m) {
+  mj_staticFlexRebuild(m);
+}
diff --git a/src/engine/engine_staticflex.h b/src/engine/engine_staticflex.h
new file mode 100644
index 0000000..dade333
--- /dev/null
+++ b/src/engine/engine_staticflex.h
@@ -0,0 +1,62 @@
+// Copyright 2026 RMsimUE5 contributors
+// Licensed under the Apache License, Version 2.0.
+
+#ifndef MUJOCO_SRC_ENGINE_ENGINE_STATICFLEX_H_
+#define MUJOCO_SRC_ENGINE_ENGINE_STATICFLEX_H_
+
+#include <stddef.h>
+#include <stdint.h>
+#include <mujoco/mjdata.h>
+#include <mujoco/mjexport.h>
+#include <mujoco/mjmodel.h>
+
+// Private allocation metadata. These records live after the public buffer,
+// not inside mjModel/mjData, so public sizes, field offsets and MJB stay intact.
+// Model/data allocations must belong to this runtime, as with the stock ABI.
+typedef struct mjStaticFlexModelCache_ {
+  uint64_t revision;
+  int count;
+  mjtByte* world;
+} mjStaticFlexModelCache;
+
+typedef struct mjStaticFlexDataCache_ {
+  const mjModel* owner;
+  uint64_t revision;
+  mjtBool valid;
+  mjtBool bvh;
+} mjStaticFlexDataCache;
+
+static inline size_t mj_staticFlexTailOffset(mjtSize nbuffer) {
+#ifdef _MSC_VER
+  const size_t model_align = __alignof(mjStaticFlexModelCache);
+  const size_t data_align = __alignof(mjStaticFlexDataCache);
+#else
+  const size_t model_align = _Alignof(mjStaticFlexModelCache);
+  const size_t data_align = _Alignof(mjStaticFlexDataCache);
+#endif
+  const size_t a = model_align > data_align ? model_align : data_align;
+  return ((size_t)nbuffer + a - 1) / a * a;
+}
+
+static inline mjStaticFlexModelCache* mj_staticFlexModel(const mjModel* m) {
+  return (mjStaticFlexModelCache*)((char*)m->buffer + mj_staticFlexTailOffset(m->nbuffer));
+}
+
+static inline mjStaticFlexDataCache* mj_staticFlexData(const mjData* d) {
+  return (mjStaticFlexDataCache*)((char*)d->buffer + mj_staticFlexTailOffset(d->nbuffer));
+}
+
+// Eligibility is recomputed after compilation, MJB load, model copy and
+// mj_setConstGroups. Only 2D rigid non-interpolated flexes entirely on world qualify.
+void mj_staticFlexRebuild(mjModel* m);
+void mj_staticFlexFree(mjModel* m);
+void mj_staticFlexInvalidate(mjData* d);
+int mj_staticFlexWorld(const mjModel* m, int f);
+int mj_staticFlexCurrent(const mjModel* m, const mjData* d, int needbvh);
+void mj_staticFlexCommit(const mjModel* m, mjData* d, int bvh);
+
+// Explicit invalidation for callers editing compiled static geometry directly.
+// mj_setConst performs this automatically. Structural changes still need recompile.
+MJAPI void mjrmsim_invalidateStaticFlex(mjModel* m);
+
+#endif
