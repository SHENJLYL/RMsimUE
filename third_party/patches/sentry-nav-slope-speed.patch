diff --git a/ros2_ws/src/terrain_analysis/include/terrain_analysis/slope_ground.hpp b/ros2_ws/src/terrain_analysis/include/terrain_analysis/slope_ground.hpp
new file mode 100644
--- /dev/null
+++ b/ros2_ws/src/terrain_analysis/include/terrain_analysis/slope_ground.hpp
@@ -0,0 +1,130 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <vector>
+
+namespace terrain_analysis
+{
+// Use the actual XY of the lowest return in each cell. A low quantile over
+// three cells alone mixes different ground heights on an inclined surface.
+class SlopeGround
+{
+public:
+  explicit SlopeGround(int width) : width_(width), low_(width * width), planes_(width * width) {}
+
+  void reset(double tangent)
+  {
+    max_gradient_ = tangent;
+    if (enabled()) {
+      std::fill(low_.begin(), low_.end(), Sample{});
+      std::fill(planes_.begin(), planes_.end(), Plane{});
+    }
+  }
+
+  void observe(int ix, int iy, double x, double y, double z)
+  {
+    if (!enabled() || !inside(ix, iy)) {return;}
+    auto & sample = low_[index(ix, iy)];
+    if (!sample.valid || z < sample.z) {sample = {x, y, z, true};}
+  }
+
+  void fit()
+  {
+    if (!enabled()) {return;}
+    for (int ix = 0; ix < width_; ++ix) {
+      for (int iy = 0; iy < width_; ++iy) {
+        if (!low_[index(ix, iy)].valid) {continue;}
+        std::array<Sample, 9> neighbors{};
+        for (int dx = -1; dx <= 1; ++dx) {
+          for (int dy = -1; dy <= 1; ++dy) {
+            if (inside(ix + dx, iy + dy)) {
+              neighbors[3 * (dx + 1) + dy + 1] = low_[index(ix + dx, iy + dy)];
+            }
+          }
+        }
+        auto & result = planes_[index(ix, iy)];
+        // Try the whole patch first, then a half-patch at a slope transition.
+        for (const auto & region : regions_) {
+          const auto plane = fitRegion(neighbors, region);
+          if (plane.valid) {
+            result = plane;
+            break;
+          }
+        }
+      }
+    }
+  }
+
+  bool onSlope(int ix, int iy, double x, double y, double z) const
+  {
+    if (!enabled() || !inside(ix, iy)) {return false;}
+    const auto & plane = planes_[index(ix, iy)];
+    return plane.valid && std::abs(z - plane.height(x, y)) <= residual_;
+  }
+
+private:
+  struct Sample { double x{}, y{}, z{}; bool valid{}; };
+  struct Plane {
+    double x{}, y{}, z{}, gx{}, gy{};
+    bool valid{};
+    double height(double px, double py) const {return z + gx * (px - x) + gy * (py - y);}
+  };
+  static constexpr double residual_ = 0.035;
+  // Inclusive crop in a 3x3 patch, always retaining the point's own cell.
+  static constexpr std::array<std::array<int, 4>, 5> regions_{{
+    {0, 2, 0, 2}, {0, 1, 0, 2}, {1, 2, 0, 2}, {0, 2, 0, 1}, {0, 2, 1, 2}}};
+
+  Plane fitRegion(const std::array<Sample, 9> & points, const std::array<int, 4> & region) const
+  {
+    Plane plane;
+    int count = 0;
+    const auto selected = [&](int i) {
+      return i / 3 >= region[0] && i / 3 <= region[1] &&
+             i % 3 >= region[2] && i % 3 <= region[3] && points[i].valid;
+    };
+    for (int i = 0; i < 9; ++i) {
+      if (!selected(i)) {continue;}
+      ++count;
+      plane.x += points[i].x;
+      plane.y += points[i].y;
+      plane.z += points[i].z;
+    }
+    if (count < 5) {return {};}
+    plane.x /= count;
+    plane.y /= count;
+    plane.z /= count;
+    double xx = 0.0, xy = 0.0, yy = 0.0, xz = 0.0, yz = 0.0;
+    for (int i = 0; i < 9; ++i) {
+      if (!selected(i)) {continue;}
+      const double x = points[i].x - plane.x;
+      const double y = points[i].y - plane.y;
+      const double z = points[i].z - plane.z;
+      xx += x * x; xy += x * y; yy += y * y; xz += x * z; yz += y * z;
+    }
+    const double det = xx * yy - xy * xy;
+    if (det <= 0.0002) {return {};}
+    plane.gx = (yy * xz - xy * yz) / det;
+    plane.gy = (xx * yz - xy * xz) / det;
+    const double gradient = std::hypot(plane.gx, plane.gy);
+    if (gradient < 0.08 || gradient > max_gradient_) {return {};}
+    for (int i = 0; i < 9; ++i) {
+      if (!points[i].valid) {continue;}
+      const double dz = points[i].z - plane.height(points[i].x, points[i].y);
+      // A lower neighboring surface rules out fitting the top of a step or box.
+      if (dz < -residual_ || (selected(i) && dz > residual_)) {return {};}
+    }
+    plane.valid = true;
+    return plane;
+  }
+
+  bool enabled() const {return max_gradient_ > 0.0;}
+  bool inside(int x, int y) const {return x >= 0 && y >= 0 && x < width_ && y < width_;}
+  int index(int x, int y) const {return x * width_ + y;}
+  int width_;
+  double max_gradient_{};
+  std::vector<Sample> low_;
+  std::vector<Plane> planes_;
+};
+}  // namespace terrain_analysis
diff --git a/ros2_ws/src/terrain_analysis/test/slope_ground_test.cpp b/ros2_ws/src/terrain_analysis/test/slope_ground_test.cpp
new file mode 100644
--- /dev/null
+++ b/ros2_ws/src/terrain_analysis/test/slope_ground_test.cpp
@@ -0,0 +1,38 @@
+#include "terrain_analysis/slope_ground.hpp"
+#include <cmath>
+#include <iostream>
+
+int main()
+{
+  terrain_analysis::SlopeGround ground(5);
+  const double max_gradient = std::tan(35.0 * std::acos(-1.0) / 180.0);
+  for (double gradient : {.65, -.65}) {
+    ground.reset(max_gradient);
+    for (int x = 0; x < 5; ++x) {
+      for (int y = 0; y < 5; ++y) {
+        double xx = .2*x-.075, yy = .2*y+.04;
+        double z = gradient*xx + .1*yy;
+        ground.observe(x,y,xx,yy,z+.16);
+        ground.observe(x,y,xx,yy,z);
+      }
+    }
+    ground.fit();
+    if (!ground.onSlope(2,2,.46,.47,gradient*.46+.1*.47) ||
+         ground.onSlope(2,2,.46,.47,gradient*.46+.1*.47+.15)) {return 1;}
+  }
+  std::cout << "PASS uphill downhill and obstacle over ramp\n";
+  for (int kind = 0; kind < 3; ++kind) {
+    ground.reset(max_gradient);
+    for (int x = 0; x < 5; ++x) {
+      for (int y = 0; y < 5; ++y) {
+        double xx = .2*x, yy = .2*y;
+        double z = kind==0 ? xx : kind==1 && x>=2 ? .16 : 0.;
+        if (kind != 2 || y==2) {ground.observe(x,y,xx,yy,z);}
+      }
+    }
+    ground.fit();
+    const double z = kind==0 ? .4 : kind==1 ? .16 : 0.;
+    if (ground.onSlope(2,2,.4,.4,z)) {return 1;}
+  }
+  std::cout << "PASS steep face, step and collinear returns remain unclassified\n";
+}
