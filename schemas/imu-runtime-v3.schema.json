{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IMU runtime profile with explicit range and quantization modeling assumptions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "calibrated",
    "imus"
  ],
  "properties": {
    "schema": {
      "const": "rm_imu_runtime_v3"
    },
    "calibrated": {
      "const": false
    },
    "imus": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "parent_frame",
          "origin",
          "rate_hz",
          "accel_bias_mps2",
          "gyro_bias_rad_s",
          "accel_noise_std_mps2",
          "gyro_noise_std_rad_s",
          "noise_seed",
          "measurement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
            "not": {
              "const": "base"
            }
          },
          "parent_frame": {
            "enum": [
              "base_link",
              "yaw_link"
            ]
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "xyz",
              "rpy"
            ],
            "properties": {
              "xyz": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -5,
                  "maximum": 5
                }
              },
              "rpy": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -6.283185307179586,
                  "maximum": 6.283185307179586
                }
              }
            }
          },
          "rate_hz": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000
          },
          "accel_bias_mps2": {
            "$ref": "#/$defs/bias"
          },
          "gyro_bias_rad_s": {
            "$ref": "#/$defs/bias"
          },
          "accel_noise_std_mps2": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "gyro_noise_std_rad_s": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          },
          "noise_seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "measurement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "accel_range_mps2",
              "gyro_range_rad_s",
              "accel_quantization_mps2",
              "gyro_quantization_rad_s"
            ],
            "properties": {
              "accel_range_mps2": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "gyro_range_rad_s": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "accel_quantization_mps2": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "gyro_quantization_rad_s": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "bias": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": -100,
        "maximum": 100
      }
    }
  },
  "$comment": "All acceleration and angular velocity fields are SI. A zero range disables saturation; zero quantization disables rounding. Internal MID-360 default output is 200 Hz. Configured full scales and zero noise are explicit uncalibrated assumptions, not measured factory settings; see docs/sensors/mid360-physical-model.md."
}
