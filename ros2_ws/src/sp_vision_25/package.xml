<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sp_vision_25</name>
  <version>0.3.0</version>
  <description>RMUC 2027 C++17 sp_vision_25 ROS 2 auto-aim node (OpenVINO/OpenCV DNN YOLOv8 + full-res HSV lightbar/outpost sticker + tiny_resnet + PnP + world tracker + 17mm ballistic lead) for both Windows UE5 simulation and Ubuntu real robot deployment.</description>
  <maintainer email="ssyjs16@nottingham.edu.cn">UNNC AIM</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>dji_referee_protocol</depend>
  <depend>geometry_msgs</depend>
  <depend>nlohmann_json</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>sp_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
