{
  "schema_version": 1,
  "id": "sentry_omni",
  "display_name": "Sentry omni reference (uncalibrated)",
  "model": {
    "format": "urdf",
    "path": "model/robot.urdf"
  },
  "control": {
    "type": "holonomic",
    "base_link": "base_link",
    "wheel_joints": [
      "wheel_0_joint",
      "wheel_1_joint",
      "wheel_2_joint",
      "wheel_3_joint"
    ],
    "gimbal": {
      "yaw_joint": "yaw_joint",
      "pitch_joint": "pitch_joint"
    },
    "limits": {
      "linear_mps": 3.0,
      "angular_rps": 4.0
    }
  },
  "sensors": [
    {
      "id": "aim_camera",
      "type": "camera",
      "parent_link": "pitch_link",
      "origin": {
        "xyz": [
          0.12,
          0,
          0.025
        ],
        "rpy": [
          0,
          0,
          0
        ]
      },
      "rate_hz": 60,
      "parameters": {
        "width": 1280,
        "height": 1024,
        "horizontal_fov_rad": 0.72
      }
    },
    {
      "id": "gimbal_imu",
      "type": "imu",
      "parent_link": "pitch_link",
      "origin": {
        "xyz": [
          0,
          0,
          0
        ],
        "rpy": [
          0,
          0,
          0
        ]
      },
      "rate_hz": 200,
      "parameters": {}
    },
    {
      "id": "navigation_lidar",
      "type": "lidar",
      "parent_link": "base_link",
      "origin": {
        "xyz": [
          0,
          0,
          0.3
        ],
        "rpy": [
          0,
          0,
          0
        ]
      },
      "rate_hz": 10,
      "parameters": {
        "horizontal_samples": 720,
        "range_min_m": 0.1,
        "range_max_m": 30
      }
    }
  ]
}
